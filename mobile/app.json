{
  "expo": {
    "name": "SallySudo",
    "slug": "sudoku-sally-v3",
    "version": "3.11.49",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sudokusallyv3",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "52.0.0",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sudokusally.v3",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Sudoku Sally to access your camera so you can video-call your opponent during a challenge.",
        "NSMicrophoneUsageDescription": "Allow Sudoku Sally to access your microphone so you can talk to your opponent during a challenge."
      }
    },
    "android": {
      "package": "com.sudokusally.v3",
      "versionCode": 31149,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0a0a1a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH"
      ]
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-asset",
      "expo-router",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Sudoku Sally to access your camera so you can video-call your opponent during a challenge.",
          "microphonePermission": "Allow Sudoku Sally to access your microphone so you can talk to your opponent during a challenge."
        }
      ]
    ]
  }
}