# Web build of the Sudoku Sally app — produced by:
#   cd mobile && npx expo export --platform web
# then this image bakes the resulting `dist/` into a tiny nginx container.

FROM nginx:1.27-alpine

# Replace the default site config with one that handles expo-router static routes
RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx-web.conf /etc/nginx/conf.d/sudoku-web.conf

# Static export
COPY dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=4s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:80/ || exit 1
