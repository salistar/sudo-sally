# ────────────────────────────────────────────────────────────────────────
# Add this block to the box's Caddyfile (server 2 / gowithsally-prod):
#   ~/apps/go-with-sally-backoffice/Caddyfile
# then reload Caddy:
#   docker exec gws-caddy caddy reload --config /etc/caddy/Caddyfile
#
# Requirements:
#  - The sudoku-landing container must be on the `gowithsally_gws-net` network
#    (handled by deploy/docker-compose.prod.yml).
#  - A DNS record  sudoku.gowithsally.com → 88.198.205.229  must exist.
#    Set it to "DNS only" (grey cloud) in Cloudflare until Caddy issues the
#    Let's Encrypt cert (HTTP-01), then it may be switched back to Proxied.
# ────────────────────────────────────────────────────────────────────────

sudoku.gowithsally.com {
	encode gzip zstd
	reverse_proxy sudoku-landing:80
}
