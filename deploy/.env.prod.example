# Copy to deploy/.env.prod on the server and fill in real values.
# This file (.env.prod) is gitignored — never commit secrets.
# (CI writes it automatically from GitHub secrets — see .github/workflows/deploy.yml)

# Secret used by the backend to sign JWTs (use a long random string)
JWT_SECRET=change_me_to_a_long_random_secret

# Redis password (sudoku-redis + redis-commander)
REDIS_PASSWORD=change_me_openssl_rand_hex_24

# Credentials for the admin UIs (mongo-express + redis-commander)
UI_USER=sally
UI_PASS=change_me_strong_password
